{
  "name": "petstore-api",
  "version": "1.0.0",
  "description": "This is a sample Pet Store Server based on the OpenAPI 3.1 specification",
  "keywords": [
    "api-client",
    "generated",
    "openapi",
    "typescript"
  ],
  "license": "Apache 2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "default": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "fmt": "vp fmt"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite-plus": "^1.5.0"
  }
}
