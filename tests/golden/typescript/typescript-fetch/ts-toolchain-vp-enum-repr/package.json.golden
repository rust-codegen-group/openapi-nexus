{
  "name": "enum-representation-api",
  "version": "1.0.0",
  "description": "This API demonstrates all 4 kinds of enum representation types: Externally Tagged, Internally Tagged, Adjacently Tagged, and Untagged",
  "keywords": [
    "api-client",
    "generated",
    "openapi",
    "typescript"
  ],
  "license": "MIT OR Apache-2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "default": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "fmt": "vp fmt"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite-plus": "^1.5.0"
  }
}
