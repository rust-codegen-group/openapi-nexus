            return false
        }
        return true
    }

    private fun matches72(candidate: JsonElement): kotlin.Boolean {
        if (!candidate.isJsonObject) {
            return false
        }
        val jsonObject = candidate.asJsonObject
        if (!jsonObject.has("outer_name") || !matches1(jsonObject.get("outer_name"))) {
            return false
        }
        return true
    }

    private fun matches73(candidate: JsonElement): kotlin.Boolean {
        if (!candidate.isJsonObject) {
            return false
        }
        val jsonObject = candidate.asJsonObject
        if (!jsonObject.has("type") || !matches74(jsonObject.get("type"))) {
            return false
        }
        return true
    }

    private fun matches74(candidate: JsonElement): kotlin.Boolean {
        return candidate.isJsonPrimitive && candidate.asJsonPrimitive.isString && candidate.asString == "other"
    }

    private fun matches75(candidate: JsonElement): kotlin.Boolean {
        return candidate.isJsonPrimitive && candidate.asJsonPrimitive.isString && candidate.asString == "tool_search_output"
    }

    private fun numberSignificand(literal: kotlin.String): java.math.BigDecimal {
        val exponent = maxOf(literal.indexOf('e'), literal.indexOf('E'))
        return java.math.BigDecimal(if (exponent < 0) literal else literal.substring(0, exponent)).stripTrailingZeros()
    }

    private fun numberExponent(literal: kotlin.String): java.math.BigInteger {
        val exponent = maxOf(literal.indexOf('e'), literal.indexOf('E'))
        return if (exponent < 0) java.math.BigInteger.ZERO else java.math.BigInteger(literal.substring(exponent + 1))
    }

    private fun isIntegerNumber(candidate: JsonElement): kotlin.Boolean {
        val literal = candidate.asString
        val significand = numberSignificand(literal)
        return significand.signum() == 0 || numberExponent(literal).compareTo(java.math.BigInteger.valueOf(significand.scale().toLong())) >= 0
    }

    private fun isBinaryNumber(candidate: JsonElement): kotlin.Boolean {
        if (!candidate.isJsonPrimitive || !candidate.asJsonPrimitive.isNumber || !isIntegerNumber(candidate)) {
            return false
        }
        val literal = candidate.asString
        val significand = numberSignificand(literal)
        if (significand.signum() == 0) {
            return true
        }
        val scale = numberExponent(literal).subtract(java.math.BigInteger.valueOf(significand.scale().toLong()))
        if (scale.compareTo(java.math.BigInteger.valueOf(2)) > 0) {
            return false
        }
        val number = significand.unscaledValue().multiply(java.math.BigInteger.TEN.pow(scale.toInt()))
        return number.compareTo(java.math.BigInteger.valueOf(-128)) >= 0 && number.compareTo(java.math.BigInteger.valueOf(255)) <= 0
    }

    private fun matchesNumber(candidate: JsonElement, expected: kotlin.String): kotlin.Boolean {
        val literal = candidate.asString
        val significand = numberSignificand(literal)
        val expectedNumber = java.math.BigDecimal(expected).stripTrailingZeros()
        if (significand.unscaledValue() != expectedNumber.unscaledValue()) {
            return false
        }
        return significand.signum() == 0 || numberExponent(literal) == java.math.BigInteger.valueOf(significand.scale().toLong() - expectedNumber.scale())
    }
}
