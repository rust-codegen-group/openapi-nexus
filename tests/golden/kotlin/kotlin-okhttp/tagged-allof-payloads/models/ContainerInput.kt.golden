        return true
    }

    private fun matches72(candidate: JsonElement): kotlin.Boolean {
        if (!candidate.isJsonObject) {
            return false
        }
        val jsonObject = candidate.asJsonObject
        if (!jsonObject.has("variantVariantKAllOf2AllOf1") || !matches73(jsonObject.get("variantVariantKAllOf2AllOf1"))) {
            return false
        }
        if (!jsonObject.has("variantVariantKAllOf2AllOf2") || !matches74(jsonObject.get("variantVariantKAllOf2AllOf2"))) {
            return false
        }
        return true
    }

