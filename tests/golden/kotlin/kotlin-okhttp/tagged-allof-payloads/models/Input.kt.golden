        if (!candidate.isJsonObject) {
            return false
        }
        val jsonObject = candidate.asJsonObject
        if (!jsonObject.has("toolNestedFieldsAllOf2AllOf1") || !matches73(jsonObject.get("toolNestedFieldsAllOf2AllOf1"))) {
            return false
        }
        if (!jsonObject.has("toolNestedFieldsAllOf2AllOf2") || !matches74(jsonObject.get("toolNestedFieldsAllOf2AllOf2"))) {
            return false
        }
        return true
    }

