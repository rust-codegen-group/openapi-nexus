{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["typecheck.ts", "typecheck.tagged-allof.ts", "typecheck.optional-discriminator-union.ts", "typecheck.inferred-union-selection.ts", "typecheck.authored-tagged-projections.ts"]
}
